{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tablewise-recipe-search",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "RECIPE_RATE_LIMITER",
      "namespace_id": "103021",
      "simple": {"limit": 10, "period": 60}
    }
  ],
  "secrets": {"required": ["RECIPE_API_KEY"]}
}
