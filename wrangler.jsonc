{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tablewise-kroger",
  "main": "cloudflare/kroger/worker.js",
  "compatibility_date": "2026-10-12",
  "kv_namespaces": [
    {
      "binding": "KROGER_KV",
      "id": "c06851ca156e47ee887b91c235a9d0d4"
    }
  ],
  "secrets": {
    "required": [
      "KROGER_CLIENT_ID",
      "KROGER_CLIENT_SECRET",
      "KROGER_TOKEN_ENCRYPTION_KEY"
    ]
  },
  "vars": {
    "KROGER_APP_ORIGIN": "https://gcfd8hy5mb-ai.github.io",
    "KROGER_APP_RETURN": "https://gcfd8hy5mb-ai.github.io/Meal-Planner-/",
    "KROGER_PREVIEW_ORIGIN": "https://tablewise-luxury-preview.pages.dev",
    "KROGER_PREVIEW_RETURN": "https://tablewise-luxury-preview.pages.dev/luxury-v2/index.html"
  }
}
